# Build artefacts of `pip install .`
build/
dist/
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/

# app/data/ is PACKAGE data (the bundled minimal dataset), not a runtime data
# directory — the repo root ignores `data/`, so re-include it explicitly or the
# package ships without its fallback and `import foodcore` breaks on install.
!app/data/
# Reference datasets are built on the host, never committed: a USDA export is
# tens of megabytes of third-party data, and the host app owns the file.
*.sqlite
*.sqlite.partial
# The real USDA FoodData Central exports are 3 MB - 500 MB per file and the
# full bulk download is gigabytes. Production points `load_fdc_csv()` at an
# unpacked export under the data dir; tests use the ~45 KB carved fixture in
# tests/fixtures/. Nothing full-size is ever committed.
FoodData_Central_*/
FoodData_Central_*.zip
data/usda/
*.zip
