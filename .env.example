# myMeal configuration — EXAMPLE ONLY.
#
# Copy to .env and edit. Every value here is a placeholder: this file
# contains NO usable secrets and is safe to commit.
#
# Generated by tools/gen_config_docs.py from the settings inventory.
# Do not edit by hand — CI regenerates and diffs it.
#
# Full reference, including security impact: docs/configuration.md

# --- Storage -------------------------------------------------------
# Directory for the SQLite database and uploaded images.
#MYMEAL_DATA_DIR=./data

# Full SQLAlchemy URL. Blank = SQLite inside DATA_DIR. Postgres is
# supported: postgresql+psycopg://user:pass@host:5432/dbname.
# SECRET. Also supported: MYMEAL_DATABASE_URL_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_DATABASE_URL=

# Home Assistant only: discover the Shared PostgreSQL add-on and use a
# database it provisions for myMeal. Ignored when DATABASE_URL is set.
#MYMEAL_USE_SHARED_POSTGRES=false

# Token for the Shared PostgreSQL add-on's provisioning API. Leave blank to
# auto-obtain it via discovery; set it to the add-on's token if discovery
# can't supply it.
# SECRET. Also supported: MYMEAL_POSTGRES_PROVISION_TOKEN_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_POSTGRES_PROVISION_TOKEN=

# --- Security ------------------------------------------------------
# JWT signing key. Blank = generated once and persisted in DATA_DIR.
# SECRET. Also supported: MYMEAL_SECRET_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_SECRET_KEY=

# How long an issued token stays valid, in hours.
#MYMEAL_JWT_HOURS=168

# Bind every request to a single local user. ONLY safe behind an
# authenticating proxy such as Home Assistant ingress.
#MYMEAL_DISABLE_AUTH=false

# Allow anyone who can reach the app to create an account.
#MYMEAL_ALLOW_REGISTRATION=true

# Enable request rate limiting on sensitive endpoints (login, registration,
# AI chat and recipe import). Disabled automatically under tests. Behind HA
# ingress the limit is per-household.
#MYMEAL_RATELIMIT_ENABLED=true

# --- Network & proxy -----------------------------------------------
# HTTP port for the app.
#MYMEAL_PORT=7850

# Comma-separated origins allowed to make credentialed cross-origin
# requests. Empty = same-origin only (correct for normal deployments).
#MYMEAL_CORS_ORIGINS=

# How many reverse proxies sit in front. 0 = do not trust X-Forwarded-*
# headers at all.
#MYMEAL_TRUSTED_PROXY_COUNT=0

# --- AI providers --------------------------------------------------
# Which AI backend to use. Blank disables AI features cleanly.
#MYMEAL_AI_PROVIDER=

# API key for the claude provider.
# SECRET. Also supported: MYMEAL_ANTHROPIC_API_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_ANTHROPIC_API_KEY=

# Model for the claude provider.
#MYMEAL_CLAUDE_MODEL=claude-opus-4-8

# API key for the openai provider.
# SECRET. Also supported: MYMEAL_OPENAI_API_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_OPENAI_API_KEY=

# Model for the openai provider.
#MYMEAL_OPENAI_MODEL=gpt-4o-mini

# Override the OpenAI API base URL (for compatible gateways / local SLM
# servers such as LM Studio, vLLM, llama.cpp).
#MYMEAL_OPENAI_BASE_URL=

# Base URL of the Ollama server. A local server needs no key; set
# OLLAMA_API_KEY for Ollama Cloud or a secured/proxied instance.
#MYMEAL_OLLAMA_HOST=http://localhost:11434

# Model for the ollama provider.
#MYMEAL_OLLAMA_MODEL=llama3.1

# Optional bearer token for the ollama provider (Ollama Cloud or a secured
# instance). Blank for a plain local server.
# SECRET. Also supported: MYMEAL_OLLAMA_API_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_OLLAMA_API_KEY=

# Ollama API key (ollama.com) for the hosted web search — used to import a
# recipe by name. Blank falls back to OLLAMA_API_KEY.
# SECRET. Also supported: MYMEAL_OLLAMA_SEARCH_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_OLLAMA_SEARCH_KEY=

# TheMealDB API key for import-by-name. Blank uses the public test key (fine
# for home use); a supporter key from themealdb.com removes its limits.
# SECRET. Also supported: MYMEAL_MEALDB_KEY_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_MEALDB_KEY=

# Per-request timeout for AI provider calls.
#MYMEAL_AI_TIMEOUT_SECONDS=60

# Auto-tagging: a proposed tag at/above this model-reported confidence (and
# matching an existing tag) is applied automatically; below it, or a new
# tag, goes to the review queue.
#MYMEAL_AI_CONFIDENCE_THRESHOLD=0.8

# --- MCP (Home Assistant Assist) -----------------------------------
# Run the MCP server so Home Assistant Assist can use myMeal as a tool.
#MYMEAL_MCP_ENABLED=true

# Bind address for the MCP server.
#MYMEAL_MCP_HOST=0.0.0.0

# Port for the MCP server (SSE).
#MYMEAL_MCP_PORT=7851

# Backend API URL the MCP server calls. Blank = derived from PORT.
#MYMEAL_MCP_API=

# Token the MCP server uses when app auth is enabled.
# SECRET. Also supported: MYMEAL_MCP_API_TOKEN_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_MCP_API_TOKEN=

# Bearer token Home Assistant must present to reach the MCP server. Blank
# leaves it unauthenticated (only safe on a trusted network).
# SECRET. Also supported: MYMEAL_MCP_SERVER_TOKEN_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_MCP_SERVER_TOKEN=

# Reach the MCP server from OUTSIDE Home Assistant. When on, every request
# must present a Full- or MCP-scoped API key, and the server refuses to
# start until such a key exists — so it is never open. You must also map
# port 7851 in the add-on's Network tab.
#MYMEAL_MCP_EXPOSE_EXTERNAL=false

# Expose read-only debugging tools over MCP (recent logs, error summary,
# metrics, diagnostics) so an AI client can investigate a problem. Off by
# default. When on, those tools require an API key with the 'debug' scope —
# ALWAYS, including on the Home Assistant network, because logs contain
# sign-in emails and tracebacks that can carry a database password. No debug
# key exists = not served at all.
#MYMEAL_MCP_DEBUG_TOOLS=false

# Treat a dead MCP process as making the whole app UNREADY.
#MYMEAL_MCP_REQUIRED=false

# --- Edibl integration (companion inventory app) -------------------
# Base URL of a companion Edibl instance (e.g. http://edibl:7746). Blank
# disables the integration. When set, myMeal can pull real stock and push
# meal-plan ingredients. Can also be set in the UI (remembered).
#MYMEAL_EDIBL_URL=

# API token myMeal presents to Edibl (Edibl tokens API). Sent as a Bearer
# token. Not needed when Edibl runs behind HA ingress with auth disabled.
# SECRET. Also supported: MYMEAL_EDIBL_API_TOKEN_FILE=/run/secrets/... (Docker secrets)
#MYMEAL_EDIBL_API_TOKEN=

# --- Serving -------------------------------------------------------
# Gunicorn worker processes. SQLite is single-writer: more workers raises
# write contention, it does not raise write throughput.
#MYMEAL_WORKERS=2

# Gunicorn threads per worker.
#MYMEAL_THREADS=4

# Run the in-process background-job worker thread (async AI tooling, e.g.
# bulk nutrition estimation).
#MYMEAL_WORKER_ENABLED=true

# Gunicorn worker timeout (seconds).
#MYMEAL_TIMEOUT=120

# Seconds to finish in-flight requests on shutdown.
#MYMEAL_GRACEFUL_TIMEOUT=30

# Maximum upload size in MB.
#MYMEAL_MAX_UPLOAD_MB=50

# Timeout for outbound HTTP (recipe import).
#MYMEAL_HTTP_TIMEOUT_SECONDS=20

# Maximum bytes read from a page during recipe import.
#MYMEAL_MAX_IMPORT_BYTES=5242880

# --- Misc ----------------------------------------------------------
# Path to the built SPA. Blank = the location baked into the image.
#MYMEAL_FRONTEND_DIST=

# Application log level.
#MYMEAL_LOG_LEVEL=INFO

# Log a line for any request slower than this many milliseconds. 0 logs
# every request, which fills the log on a busy instance — the gunicorn
# access log already covers the ordinary case.
#MYMEAL_SLOW_REQUEST_MS=1000

# Flask debug mode. NEVER enable in production — it exposes an interactive
# debugger that executes arbitrary code.
#MYMEAL_DEBUG=false
